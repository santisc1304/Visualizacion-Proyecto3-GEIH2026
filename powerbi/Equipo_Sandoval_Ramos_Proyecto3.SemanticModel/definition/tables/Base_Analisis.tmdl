	partition Base_Analisis = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("C:\Users\santi\Desktop\TrabajosUEC\Visualización\Equipo_Sandoval_Ramos_Proyecto3\data\processed\base_geih_ciudadana_analisis.csv"), [Delimiter=",", Columns=19, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {
				        {"MES", Int64.Type}, {"DIRECTORIO", Int64.Type}, {"SECUENCIA_P", Int64.Type},
				        {"ORDEN", Int64.Type}, {"HOGAR", Int64.Type}, {"FEX_C18", type number},
				        {"DPTO", type text}, {"P6430", Int64.Type}, {"P6500", type number},
				        {"INGLABO", type number}, {"RAMA2D_R4", type text}, {"P3271", Int64.Type},
				        {"P6040", Int64.Type}, {"DPTO_Nombre", type text}, {"SectorEconomico", type text},
				        {"GrupoEdad", type text}, {"Sexo", type text}, {"TipoTrabajador", type text},
				        {"ID_Persona", type text}
				    }, "en-US")
				in
				    Tipos

	annotation PBI_NavigationStepName = Navegación

